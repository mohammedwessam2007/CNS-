      tourT = setTimeout(i < ids.length ? step : function () { tourT = null; unlink(); fly(HOME.pos, HOME.target, 1200); document.querySelectorAll("[data-tour]").forEach(function (x) { x.textContent = "▶ Play the tour again"; }); }, 2700);
    }
    step();
  }
  function stopTour() { if (tourT) { clearTimeout(tourT); tourT = null; } }
