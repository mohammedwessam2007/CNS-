    if (tagLeft < 8) tagLeft = Math.min(innerWidth - tw - 8, ex + 16);
    thTag.style.transform = "translate(" + tagLeft.toFixed(0) + "px," + (ey - 20).toFixed(0) + "px)"; thTag.style.opacity = pe;
  }
  // a short tour of his labels, one thread after another
  var tourT = null;
  function startTour(ids) {
