    if (!quiet) { if (stage === 3 || stage === 4) setFocus("carotid", true); else setFocus(null); }
  }
  function drawThread() {
    if (!LINK) return;
    tmpV.set(wx(LINK.mm[0]), wy(LINK.mm[2]) + layerY(LINK.layer), wz(LINK.mm[1])).project(camera);
    var cr = canvas.getBoundingClientRect(), ex = cr.left + (tmpV.x * 0.5 + 0.5) * cr.width, ey = cr.top + (-tmpV.y * 0.5 + 0.5) * cr.height;
    var fr = LINK.from && LINK.from.isConnected ? LINK.from.getBoundingClientRect() : null, has = fr && fr.width > 0 && fr.bottom > 0 && fr.top < innerHeight;
    var inView = tmpV.z < 1 && ex > cr.left - 40 && ex < cr.right + 40 && ey > cr.top - 40 && ey < cr.bottom + 40;
    threadSvg.classList.toggle("on", inView); thTag.classList.toggle("on", inView);
