      var d = "M" + sx.toFixed(1) + " " + sy.toFixed(1) + " C" + (sx + (ex > sx ? bend : -bend)).toFixed(1) + " " + sy.toFixed(1) + " " + (ex + (ex > sx ? -bend : bend)).toFixed(1) + " " + (ey - 30).toFixed(1) + " " + ex.toFixed(1) + " " + ey.toFixed(1);
