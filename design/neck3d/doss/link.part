    var mm = spec.n ? anchorOf(spec.n, spec.s, spec.z) : (function () { var r = RINGDIR[layer]; return onRing(r[0], spec.hi ? 70 : ST + 3, r[1], r[2]); })();
    if (!mm) return false;
