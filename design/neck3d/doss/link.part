  var LINK = null, threadSvg = document.getElementById("thread"), thPath = document.getElementById("th-path"), thFlow = document.getElementById("th-flow"), thDot = document.getElementById("th-dot"), thRing = document.getElementById("th-ring"), thTag = document.getElementById("th-tag");
  function hiPair(e) {
    if (e.hiF) return e;
    var f0 = e.front.material, c0 = e.cap.material, f = f0.clone(), c = c0.clone();
    f.clippingPlanes = f0.clippingPlanes; f.clipShadows = true; track(f, 1, "#ffffff", f0.userData.ei); f.userData.hi = true;
    c.clippingPlanes = c0.clippingPlanes; c.clipping = true; c.uniforms.map.value = c0.uniforms.map.value; track(c, 1, "#ffffff"); c.userData.cap = true; c.userData.hi = true;
    e.f0 = f0; e.c0 = c0; e.hiF = f; e.hiC = c; return e;
