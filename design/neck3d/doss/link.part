      if (s && e.side !== s) return; var P = e.P;
      for (var i = 0; i < P.length; i += 3) { var zz = P[i + 2] / 10; if (zz < SB || zz > ST) continue; sx += P[i] / 10; sy += P[i + 1] / 10; sz += zz; c++; }
    });
    return c ? [sx / c, sy / c, sz / c] : null;
  }
  var RINGDIR = { superficial: ["superficial", -0.6, -0.8], investing: ["investing", -0.75, -0.66], pretracheal: ["pretracheal", 0.45, -0.9], prevertebral: ["prevertebral", 0.95, 0.3], carotid: ["carotidR", -0.9, -0.3] };
  function link(spec, fromEl) {
