    var maxW = big ? Math.min(sw * (phone ? 0.86 : 0.62), 520) : Math.max(112, Math.min(sw * 0.26, 240));
    var maxH = big ? sh - (phone ? 120 : 150) : sh * (phone ? 0.36 : 0.5);
    var w = Math.min(maxW, maxH * d.w / d.h);
