575 0 obj
<</Type/StructElem/S/P/P 1398 0 R/E(Buffers neutralize the gastric acid, and relieve heartburn if gastric juice is abnormally regurgitated into the esophagus.)/Pg 18 0 R/K[18]>>
endobj

576 0 obj
<</Type/StructElem/S/P/P 1399 0 R/E(Maintaining healthy oral mucosa through:)/Pg 18 0 R/K[19]>>
endobj

577 0 obj
<</Type/StructElem/S/P/P 1400 0 R/E(Washing away pathogenic bacteria, and any food remnants, which provide nutrients for bacterial growth.)/Pg 18 0 R/K[20]>>
endobj

578 0 obj
<</Type/StructElem/S/P/P 1401 0 R/E(Lysozyme attacks the walls of bacteria.)/Pg 18 0 R/K[21]>>
