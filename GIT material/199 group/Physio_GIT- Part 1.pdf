736 0 obj
<</Type/StructElem/S/P/P 1438 0 R/E(Maintains relative sterility of the stomach by killing ingested bacteria.)/Pg 24 0 R/K[5]>>
endobj

737 0 obj
<</Type/StructElem/S/P/P 1439 0 R/E(Dissolves food particles and changes food into "chyme".)/Pg 24 0 R/K[6]>>
endobj

738 0 obj
<</Type/StructElem/S/P/P 1440 0 R/E(Activates the inactive pepsinogen by changing it into active pepsin.)/Pg 24 0 R/K[7]>>
endobj

739 0 obj
<</Type/StructElem/S/P/P 1441 0 R/E(Provides optimum pH for the action of pepsin.)/Pg 24 0 R/K[8]>>
endobj

740 0 obj
<</Type/StructElem/S/P/P 1442 0 R/E(Helps iron and calcium absorption.)/Pg 24 0 R/K[9]>>
endobj

